{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiko",
  "version": "1.0.7",
  "identifier": "com.kiko.diary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMDFERTAwNzVCQ0JFNjMKUldSanZyeDFBTjRCWUx4V3o1VzRnZCtwUlVMQXlYYnN6UXhVK2pWZkVsd0RjRE5rUkd2czdGRmIK",
      "endpoints": [
        "https://github.com/konomo1010/kikoDiary/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
